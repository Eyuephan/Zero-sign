# Placeholder configuration for an isolated HTTPS lab.
# Copy to .env and replace values locally. Never commit actual secrets.
NODE_ENV=development
HOST=127.0.0.1
PORT=3000
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=zso_app
DB_NAME=zso
DB_PASS=REPLACE_WITH_LOCAL_DATABASE_PASSWORD
DB_POOL=10
# Optional: use a Unix socket instead of DB_HOST / DB_PORT.
# DB_SOCKET=/run/mysqld/mysqld.sock
JWT_SECRET=REPLACE_WITH_A_LONG_RANDOM_SECRET
RPID=zso.example.test
ORIGIN=https://zso.example.test
COOKIE_SECURE=true
